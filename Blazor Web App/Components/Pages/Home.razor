@page "/"
@using Shared.Enums
@using System.Security.Claims

<PageTitle>Task Marketplace</PageTitle>

<div class="container py-5">

    <AuthorizeView>
        <Authorized Context="AuthContext">
            @{
                var userName = AuthContext.User.Identity?.Name ?? "User";
                var role = AuthContext.User.FindFirst(ClaimTypes.Role)?.Value ?? "Unknown";
            }

            <div class="p-5 mb-4 bg-light rounded-3 border">
                <div class="container-fluid py-2">
                    <h1 class="display-5 fw-bold mb-2">Task Marketplace</h1>
                    
                    <div class="d-flex align-items-center gap-3">
                        <span class="fs-5">Hello, <strong>@userName</strong></span>
                        <span class="badge bg-primary fs-6">@role</span>
                    </div>
                </div>
            </div>

            <h2 class="h4 mb-3">Quick actions</h2>

            <div class="row g-3">

                @if (AuthContext.User.IsInRole(nameof(UserRole.Customer)))
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">My Tasks</h5>
                                <p class="card-text text-muted">
                                    Manage your published tasks, view candidates and pick an executor.
                                </p>
                                <a class="btn btn-primary mt-auto" href="/tasks">Open tasks</a>
                            </div>
                        </div>
                    </div>
                }

                @if (AuthContext.User.IsInRole(nameof(UserRole.Executor)))
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">Browse Tasks</h5>
                                <p class="card-text text-muted">
                                    Find new published tasks and respond to them.
                                </p>
                                <a class="btn btn-primary mt-auto" href="/tasks">Browse</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">My Assigned Tasks</h5>
                                <p class="card-text text-muted">
                                    Tasks assigned to you, chats with customers and deadlines.
                                </p>
                                <a class="btn btn-primary mt-auto" href="/my-assigned">Open assigned</a>
                            </div>
                        </div>
                    </div>
                }

                @if (AuthContext.User.IsInRole(nameof(UserRole.Admin)))
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">Admin: Users</h5>
                                <p class="card-text text-muted">
                                    Manage users, roles, blocks and removals.
                                </p>
                                <a class="btn btn-primary mt-auto" href="/admin/users">Open users</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">Admin: Actions</h5>
                                <p class="card-text text-muted">
                                    View the user activity log with filters.
                                </p>
                                <a class="btn btn-primary mt-auto" href="/admin/actions">Open log</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="p-5 mb-4 bg-light rounded-3 border text-center">
                <h1 class="display-5 fw-bold mb-3">Task Marketplace</h1>
                
                <div class="d-flex justify-content-center gap-2">
                    <a class="btn btn-primary btn-lg" href="/login">Sign In</a>
                    <a class="btn btn-outline-secondary btn-lg" href="/register">Register</a>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>

</div>