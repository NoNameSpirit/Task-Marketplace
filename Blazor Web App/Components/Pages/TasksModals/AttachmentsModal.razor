@using Microsoft.AspNetCore.Components.Forms

@if (IsVisible)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Attachments: @TaskTitle</h5>
                    <button class="btn-close" @onclick="Close"></button>
                </div>

                <div class="modal-body">
                    @if (ErrorMessage != "")
                    {
                        <div class="alert alert-danger">@ErrorMessage</div>
                    }

                    @if (CanUpload)
                    {
                        <div class="mb-3">
                            <label class="form-label">Upload file (max 50 MB)</label>
                            <InputFile class="form-control"
                                       OnChange="HandleFileSelected"
                                       disabled="@IsUploading" />
                            @if (IsUploading)
                            {
                                <div class="spinner-border spinner-border-sm text-primary mt-2"></div>
                            }
                        </div>
                    }

                    @if (IsLoading)
                    {
                        <div class="text-center py-3">
                            <div class="spinner-border text-primary"></div>
                        </div>
                    }
                    else if (Attachments is null || Attachments.Count == 0)
                    {
                        <div class="alert alert-info">No attachments yet.</div>
                    }
                    else
                    {
                        <ul class="list-group">
                            @foreach (var a in Attachments)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div class="text-truncate me-2">
                                        <strong>@a.OriginalFileName</strong>
                                        <br />
                                        <small class="text-muted">
                                            @FormatSize(a.SizeBytes) — @a.UploadedAt.ToLocalTime().ToString("g")
                                        </small>
                                    </div>

                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => Download(a)">
                                            Download
                                        </button>

                                        @if (a.UploadedByUserId == CurrentUserId)
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => Delete(a)"
                                                    disabled="@IsDeleting">
                                                Delete
                                            </button>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Close">Close</button>
                </div>

            </div>
        </div>
    </div>
}