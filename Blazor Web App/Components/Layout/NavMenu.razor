@using global::Shared.Enums
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Blazor App</a>
        <AuthorizeView>
            <Authorized>
                <button class="btn btn-outline-light btn-sm" @onclick="HandleLogout">Sign Out</button>
            </Authorized>
            <NotAuthorized>
                <a href="/login" class="btn btn-outline-light btn-sm">Sign In</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
    <AuthorizeView>
        <Authorized Context="AuthContext">
            @if (AuthContext.User.IsInRole(nameof(UserRole.Admin)))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/users" Match="NavLinkMatch.Prefix">Admin: Users</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin/actions" Match="NavLinkMatch.Prefix">Admin: Actions</NavLink>
                </div>
            }
            @if (AuthContext.User.IsInRole(nameof(UserRole.Customer)))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/tasks" Match="NavLinkMatch.Prefix">My Tasks</NavLink>
                </div>
            }
            @if (AuthContext.User.IsInRole(nameof(UserRole.Executor)))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/tasks" Match="NavLinkMatch.Prefix">Browse Tasks</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/my-assigned" Match="NavLinkMatch.Prefix">My Assigned</NavLink>
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/login" Match="NavLinkMatch.Prefix">Sign In</NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</nav>
</div>

