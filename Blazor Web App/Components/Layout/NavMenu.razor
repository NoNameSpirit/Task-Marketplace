@using global::Shared.Enums
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Blazor App</a>
        <AuthorizeView>
            <Authorized>
                <button class="btn btn-outline-light btn-sm" @onclick="HandleLogout">Sign Out</button>
            </Authorized>
            <NotAuthorized>
                <a href="/login" class="btn btn-outline-light btn-sm">Sign In</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
          <AuthorizeView>
            <Authorized Context="AuthContext">
                @if (AuthContext.User.IsInRole(nameof(UserRole.Customer)))
                {
                    <NavLink class="nav-link" href="/tasks" Match="NavLinkMatch.Prefix">My Tasks</NavLink>
                }
                @if (AuthContext.User.IsInRole(nameof(UserRole.Executor)))
                {
                    <NavLink class="nav-link" href="/tasks" Match="NavLinkMatch.Prefix">Browse Tasks</NavLink>
                    <NavLink class="nav-link" href="/my-assigned" Match="NavLinkMatch.Prefix">My Assigned</NavLink>
                }
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

