# AppConfig.
AppConfiguration__ConnectionString=Server=sqlserver;Database=ProjectTaskDb;User Id=sa;Password=${AppConfig__Password};TrustServerCertificate=True;
AppConfiguration__Password=<YOUR_PASSWORD>

# JwtSettings.
JwtSettings__Key=<LONG_KEY_MIN_LENGTH_32>

# ApiSettings.
ApiSettings__ApiUrl=http://web_api:8080
ConnectionStrings__Redis=redis:6379